package main

import "github.com/Guid75/foobar/internal/user"

templ MainPage(currentUser user.User) {
	<!DOCTYPE html>
	<html lang="fr" class="h-full bg-gray-100">
		<head>
			<meta charset="UTF-8"/>
			<title>Foobar</title>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<script src="https://cdn.tailwindcss.com"></script>
		</head>
		<body class="h-full flex">
			<aside class="w-64 bg-slate-900 text-slate-300 flex flex-col">
				<div class="p-5 text-xl font-bold text-white border-b border-slate-800">
					Foobar
				</div>
				<nav class="flex-1 p-4 space-y-1">
					<a
						href="/dashboard"
						hx-get="/dashboard"
						hx-target="#main-content"
						hx-push-url="true"
						class="block px-4 py-2 rounded hover:bg-slate-800 hover:text-white transition"
					>
						Dashboard
					</a>
					<a
						href="/users"
						hx-get="/users"
						hx-target="#main-content"
						hx-push-url="true"
						class="block px-4 py-2 rounded hover:bg-slate-800 hover:text-white transition"
					>
						Users
					</a>
					<a
						href="/devices"
						hx-get="/devices"
						hx-target="#main-content"
						hx-push-url="true"
						class="block px-4 py-2 rounded hover:bg-slate-800 hover:text-white transition"
					>
						Devices
					</a>
				</nav>
				<div class="p-4 border-t border-slate-800">
					<button
						hx-post="/auth/logout"
						class="w-full text-left px-4 py-2 rounded text-red-400 hover:bg-slate-800 transition"
					>
						Déconnexion
					</button>
				</div>
			</aside>
			<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
				<header class="h-16 bg-white shadow-sm flex items-center px-8 justify-between">
					<h1 class="text-lg font-semibold text-gray-800">Administration</h1>
					<span class="text-sm text-gray-500">Super Admin</span>
				</header>
				<main id="main-content" class="flex-1 overflow-y-auto p-8">
					{ children... }
				</main>
			</div>
		</body>
	</html>
	// <!DOCTYPE html>
	// <html lang="en">
	// 	<head>
	// 		<meta charset="UTF-8"/>
	// 		<title>Foobar</title>
	// 		<script src="https://unpkg.com/htmx.org"></script>
	// 	</head>
	// 	<body>
	// 		<h1>Dashboard</h1>
	// 		<p>Welcome, { currentUser.Username }!</p>
	// 		<form method="post" action="/auth/logout">
	// 			<button type="submit">Log out</button>
	// 		</form>
	// 		if currentUser.Role == "super_admin" {
	// 			@user.UserList(users)
	// 		}
	// 	</body>
	// </html>
}
