package main

import "github.com/Guid75/foobar/internal/user"

templ DashboardPage(currentUser user.User, users []user.User) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<title>Dashboard</title>
			<script src="https://unpkg.com/htmx.org"></script>
		</head>
		<body>
			<h1>Dashboard</h1>
			<p>Welcome, { currentUser.Username }!</p>
			<form method="post" action="/auth/logout">
				<button type="submit">Log out</button>
			</form>
			if currentUser.Role == "super_admin" {
				@user.UserList(users)
			}
		</body>
	</html>
}
